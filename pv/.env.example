# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Postgres connection string (Vercel → Storage → Neon creates this for you).
DATABASE_URL=

# Admin login.
# Email for the requested admin account:
ADMIN_EMAIL=vakuwa@gmail.com
# Generate a scrypt hash locally with: npm run hash-password -- "your password"
# Do not put the plaintext password or the generated hash in source control.
ADMIN_PASSWORD_HASH=
# Any random string of 32+ characters, e.g. from: openssl rand -base64 32
SESSION_SECRET=

# Free key from https://developers.giphy.com (enables GIFs in comments).
GIPHY_API_KEY=

# Contact form email delivery (Resend). Verify the sender domain in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Pastor Victor Akuwa <contact@your-verified-domain.com>"
CONTACT_TO_EMAIL=vakuwa@gmail.com

# Set automatically when you connect a Vercel Blob store (blog image uploads).
# BLOB_READ_WRITE_TOKEN=

# Public address of the site, used in link previews and the sitemap.
SITE_URL=
# Optional: Google Search Console verification code.
# GOOGLE_SITE_VERIFICATION=
