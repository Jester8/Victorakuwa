# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Postgres connection string (Vercel → Storage → Neon creates this for you).
DATABASE_URL=

# Admin login. Generate the hash with: npm run hash-password -- "your password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Any random string of 32+ characters, e.g. from: openssl rand -base64 32
SESSION_SECRET=

# Free key from https://developers.giphy.com (enables GIFs in comments).
GIPHY_API_KEY=

# Set automatically when you connect a Vercel Blob store (blog image uploads).
# BLOB_READ_WRITE_TOKEN=
